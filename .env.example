# Configuración de VisualBoost

# Formulario de contacto — Formspree
# 1. Crear cuenta en https://formspree.io
# 2. Crear un nuevo formulario
# 3. Copiar el endpoint y pegarlo aquí
# 4. Para producción, agregarlo como secret en GitHub Actions
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/tu-form-id

# Sitio
SITE_URL=https://visualboost.com
SITE_NAME=VisualBoost

# Email (si usas servicio de email)
PUBLIC_EMAIL=contacto@visualboost.com
PUBLIC_WHATSAPP=+56912345678
PUBLIC_PHONE=+56212345678

# Social Media
SOCIAL_INSTAGRAM=https://instagram.com/visualboost
SOCIAL_FACEBOOK=https://facebook.com/visualboost

# Analytics (opcional)
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Node Environment
NODE_ENV=production
