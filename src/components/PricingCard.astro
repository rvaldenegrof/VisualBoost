---
interface Props {
	name: string;
	price: string;
	description: string;
	features: string[];
	highlighted?: boolean;
	ctaHref: string;
	planId: string;
}

const { name, price, description, features, highlighted = false, ctaHref, planId } = Astro.props;
---

<article
	class:list={[
		'flex flex-col rounded-2xl border p-6 md:p-8',
		highlighted
			? 'border-accent bg-accent-soft shadow-soft ring-2 ring-accent/20'
			: 'border-border bg-surface-elevated shadow-soft',
	]}
	aria-labelledby={`plan-${planId}`}
>
	<h3 id={`plan-${planId}`} class="text-lg font-bold text-ink">
		{name}
	</h3>
	<p class="mt-1 text-sm text-ink-muted">{description}</p>
	<p class="mt-4">
		<span class="text-3xl font-bold tracking-tight text-ink">{price}</span>
		<span class="text-sm text-ink-muted"> / mes · CLP</span>
	</p>
	<ul class="mt-6 flex-1 space-y-3 text-sm text-ink-muted">
		{
			features.map((f) => (
				<li class="flex gap-2">
					<span class="mt-0.5 text-accent" aria-hidden="true">✓</span>
					<span>{f}</span>
				</li>
			))
		}
	</ul>
	<a
		href={ctaHref}
		class:list={[
			'mt-8 inline-flex w-full justify-center rounded-lg px-4 py-3 text-center text-sm font-semibold transition-colors focus-visible:outline-offset-2',
			highlighted
				? 'bg-accent text-white hover:bg-accent-hover'
				: 'border border-border bg-white text-ink hover:border-accent/40 hover:bg-accent-soft',
		]}
	>
		Elegir plan
	</a>
</article>
