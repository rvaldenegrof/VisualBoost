---
const pathname = Astro.url.pathname;

const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/quienes-somos', label: 'Quiénes somos' },
	{ href: '/servicios', label: 'Servicios' },
	{ href: '/trabajos', label: 'Trabajos' },
	{ href: '/planes', label: 'Planes' },
	{ href: '/faq', label: 'FAQ' },
	{ href: '/contacto', label: 'Contacto' },
];

function isActive(href: string): boolean {
	if (href === '/') return pathname === '/';
	return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-border bg-surface-elevated/95 backdrop-blur supports-[backdrop-filter]:bg-surface-elevated/80">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
		<a href="/" class="group flex items-center gap-2 rounded-md focus-visible:outline-offset-4">
			<span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent text-sm font-bold text-white">
				VB
			</span>
			<span class="font-semibold text-ink group-hover:text-accent transition-colors">
				VisualBoost
			</span>
		</a>

		<nav aria-label="Principal" class="hidden md:block">
			<ul class="flex flex-wrap items-center gap-1 lg:gap-2">
				{
					links.map(({ href, label }) => (
						<li>
							<a
								href={href}
								class:list={[
									'rounded-md px-3 py-2 text-sm font-medium transition-colors',
									isActive(href)
										? 'bg-accent-soft text-accent'
										: 'text-ink-muted hover:bg-accent-soft/60 hover:text-accent',
								]}
								aria-current={isActive(href) ? 'page' : undefined}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a
			href="/contacto"
			class="hidden rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white shadow-soft hover:bg-accent-hover md:inline-flex"
		>
			Solicitar cotización
		</a>

		<details class="group relative md:hidden">
			<summary
				class="list-none rounded-lg border border-border px-3 py-2 text-sm font-medium text-ink [&::-webkit-details-marker]:hidden"
				aria-label="Abrir menú"
			>
				<span class="inline-flex items-center gap-2">
					Menú
					<svg class="h-4 w-4 transition group-open:rotate-180" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</span>
			</summary>
			<div
				class="absolute right-0 top-full z-50 mt-2 w-[min(100vw-2rem,18rem)] rounded-xl border border-border bg-surface-elevated p-2 shadow-soft"
			>
				<ul class="flex flex-col gap-1">
					{
						links.map(({ href, label }) => (
							<li>
								<a
									href={href}
									class:list={[
										'block rounded-lg px-3 py-2 text-sm font-medium',
										isActive(href)
											? 'bg-accent-soft text-accent'
											: 'text-ink-muted hover:bg-accent-soft/60',
									]}
									aria-current={isActive(href) ? 'page' : undefined}
								>
									{label}
								</a>
							</li>
						))
					}
				</ul>
				<a
					href="/contacto"
					class="mt-2 flex w-full justify-center rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white"
				>
					Solicitar cotización
				</a>
			</div>
		</details>
	</div>
</header>
