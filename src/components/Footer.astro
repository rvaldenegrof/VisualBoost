---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-ink text-surface">
	<div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
		<div class="grid gap-10 md:grid-cols-3">
			<div>
				<p class="font-semibold text-white">VisualBoost</p>
				<p class="mt-2 text-sm text-white/80">{siteConfig.tagline}</p>
			</div>
			<div>
				<p class="text-sm font-semibold text-white">Enlaces</p>
				<ul class="mt-3 space-y-2 text-sm text-white/85">
					<li><a href="/servicios" class="underline-offset-4 hover:underline">Servicios</a></li>
					<li><a href="/planes" class="underline-offset-4 hover:underline">Planes</a></li>
					<li><a href="/trabajos" class="underline-offset-4 hover:underline">Trabajos</a></li>
					<li><a href="/faq" class="underline-offset-4 hover:underline">Preguntas frecuentes</a></li>
				</ul>
			</div>
			<div>
				<p class="text-sm font-semibold text-white">Contacto</p>
				<ul class="mt-3 space-y-2 text-sm text-white/85">
					<li>
						<a href={`mailto:${siteConfig.email}`} class="underline-offset-4 hover:underline">{siteConfig.email}</a>
					</li>
					<li><a href="/contacto" class="underline-offset-4 hover:underline">Formulario y WhatsApp</a></li>
					<li><a href="/privacidad" class="underline-offset-4 hover:underline">Privacidad y datos</a></li>
				</ul>
			</div>
		</div>
		<p class="mt-10 border-t border-white/15 pt-8 text-center text-sm text-white/65">
			© {year} VisualBoost. Todos los derechos reservados.
		</p>
	</div>
</footer>
