---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import '../styles/global.css';
---

<BaseLayout title="404 - Página no encontrada">
  <Header client:load />
  
  <main>
    <div class="min-h-[60vh] flex items-center justify-center section-padding">
      <div class="text-center container-max">
        <div class="text-7xl mb-6">😕</div>
        
        <h1 class="heading-xl mb-4">Página no encontrada</h1>
        
        <p class="text-muted text-lg mb-8 max-w-md mx-auto">
          Parece que la página que buscas no existe o ha sido movida.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn-primary">
            Volver a Inicio
          </a>
          <a href="/contacto" class="btn-secondary">
            Contactar Soporte
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer client:load />
</BaseLayout>
