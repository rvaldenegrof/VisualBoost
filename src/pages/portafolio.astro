---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import PortfolioGallery from '../components/PortfolioGallery';
import Footer from '../components/Footer';
import '../styles/global.css';

import { PORTFOLIO_CATEGORIES, PORTFOLIO_ITEMS } from '../data/services';
---

<BaseLayout title="Portafolio - VisualBoost">
  <Header client:load />
  
  <main>
    {/* Hero section específico para portafolio */}
    <div class="pt-32 pb-16 bg-gradient-to-b from-primary-50 to-white">
      <div class="container-max section-padding">
        <h1 class="heading-xl mb-4 text-center">Nuestros Trabajos</h1>
        <p class="text-muted text-lg text-center max-w-2xl mx-auto">
          Descubre cómo hemos ayudado a emprendedores y pymes a crecer con contenido visual estratégico
        </p>
      </div>
    </div>

    <PortfolioGallery items={PORTFOLIO_ITEMS} categories={PORTFOLIO_CATEGORIES} client:load />
  </main>

  <Footer client:load />
</BaseLayout>
