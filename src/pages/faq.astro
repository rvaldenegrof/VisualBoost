---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { faqItems } from '../content/faq';
---

<Layout
	title="Preguntas frecuentes"
	description="Respuestas sobre plazos, planes VisualBoost, formatos de entrega, revisiones y más."
>
	<div class="border-b border-border bg-surface-elevated py-12 md:py-16">
		<div class="mx-auto max-w-3xl px-4 md:px-6">
			<h1 class="text-4xl font-bold tracking-tight text-ink">Preguntas frecuentes</h1>
			<p class="mt-4 text-lg text-ink-muted">
				Si no encontrás lo que buscás, escribinos por el formulario o WhatsApp.
			</p>
		</div>
	</div>

	<div class="mx-auto max-w-3xl px-4 py-12 md:px-6 md:py-16">
		<div class="divide-y divide-border rounded-2xl border border-border bg-surface-elevated">
			{
				faqItems.map((item, i) => (
					<details class="group p-6" name="faq">
						<summary class="cursor-pointer list-none text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
							<span class="flex items-start justify-between gap-4">
								{item.question}
								<svg
									class="mt-1 h-5 w-5 shrink-0 text-accent transition group-open:rotate-180"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</span>
						</summary>
						<p id={`faq-a-${i}`} class="mt-4 text-ink-muted">
							{item.answer}
						</p>
					</details>
				))
			}
		</div>

		<div class="mt-12 flex flex-wrap gap-4">
			<Button href="/contacto">Solicitar cotización</Button>
			<Button href="/planes" variant="secondary">Ver planes</Button>
		</div>
	</div>
</Layout>
