---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import Testimonials from '../components/Testimonials.astro';
import { siteConfig } from '../config/site';
---

<Layout title="VisualBoost" description={siteConfig.description}>
	<section class="relative overflow-hidden border-b border-border bg-surface-elevated">
		<div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
			<p class="text-sm font-semibold uppercase tracking-wider text-accent">Ventas digitales · Pymes</p>
			<h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-ink md:text-5xl">
				Vende más con contenido visual estratégico, no solo estético
			</h1>
			<p class="mt-6 max-w-2xl text-lg text-ink-muted">
				Fotografía de producto, lifestyle, reels y edición lista para publicar. Hablamos de forma sencilla: menos
				tecnicismos, más resultados en Instagram, marketplaces y WhatsApp.
			</p>
			<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
				<Button href="/contacto">Solicitar cotización</Button>
				<Button href="/planes" variant="secondary">Ver planes desde $120.000 CLP</Button>
				<Button href="/trabajos" variant="ghost">Ver trabajos</Button>
			</div>
			<dl class="mt-14 grid gap-6 border-t border-border pt-10 sm:grid-cols-2 lg:grid-cols-4">
				<div>
					<dt class="text-sm font-medium text-ink-muted">Entregas</dt>
					<dd class="mt-1 text-lg font-semibold text-ink">48–72 horas</dd>
				</div>
				<div>
					<dt class="text-sm font-medium text-ink-muted">Planes</dt>
					<dd class="mt-1 text-lg font-semibold text-ink">Mensuales accesibles</dd>
				</div>
				<div>
					<dt class="text-sm font-medium text-ink-muted">Enfoque</dt>
					<dd class="mt-1 text-lg font-semibold text-ink">Conversión y claridad</dd>
				</div>
				<div>
					<dt class="text-sm font-medium text-ink-muted">Para</dt>
					<dd class="mt-1 text-lg font-semibold text-ink">Emprendedores y pymes</dd>
				</div>
			</dl>
		</div>
	</section>

	<Section
		id="servicios"
		eyebrow="Servicios"
		title="Todo lo que necesitas para que tu oferta se entienda en segundos"
		subtitle="Piezas pensadas para cada etapa del viaje del cliente: descubrimiento, confianza y cierre."
	>
		<div class="grid gap-6 md:grid-cols-2">
			<Card
				icon="camera"
				title="Fotografía de producto"
				description="Imágenes que muestran beneficio, materialidad y uso: ideales para catálogo, marketplace y feed."
			/>
			<Card
				icon="spark"
				title="Fotografía lifestyle"
				description="Contexto real que humaniza tu marca y ayuda a imaginar el producto en la vida del cliente."
			/>
			<Card
				icon="film"
				title="Reels y contenido corto"
				description="Piezas verticales para historias, reels y anuncios: ritmo claro y mensaje directo."
			/>
			<Card
				icon="edit"
				title="Edición para redes"
				description="Formatos listos para publicar con tipografía legible, llamados a la acción y coherencia visual."
			/>
		</div>
		<div class="mt-10 flex flex-wrap gap-4">
			<Button href="/servicios">Detalle de servicios</Button>
			<Button href="/contacto" variant="secondary">Hablar con nosotros</Button>
		</div>
	</Section>

	<section class="border-y border-border bg-accent-soft/40 py-14 md:py-20">
		<div class="mx-auto max-w-6xl px-4 md:px-6">
			<h2 class="text-2xl font-bold tracking-tight text-ink md:text-3xl">Para quién trabajamos</h2>
			<ul class="mt-8 grid gap-4 sm:grid-cols-3">
				<li class="rounded-2xl border border-border bg-surface-elevated px-5 py-4 text-center shadow-soft">
					<span class="font-semibold text-ink">Emprendedores</span>
					<span class="mt-1 block text-sm text-ink-muted">Con o sin tienda física</span>
				</li>
				<li class="rounded-2xl border border-border bg-surface-elevated px-5 py-4 text-center shadow-soft">
					<span class="font-semibold text-ink">Pymes en IG / marketplace</span>
					<span class="mt-1 block text-sm text-ink-muted">Contenido que ordena el mensaje</span>
				</li>
				<li class="rounded-2xl border border-border bg-surface-elevated px-5 py-4 text-center shadow-soft">
					<span class="font-semibold text-ink">Negocios locales</span>
					<span class="mt-1 block text-sm text-ink-muted">En crecimiento y digitalización</span>
				</li>
			</ul>
		</div>
	</section>

	<Section
		id="diferenciales"
		eyebrow="Por qué VisualBoost"
		title="Estrategia comercial, ritmo de entrega y planes claros"
		subtitle="No dejamos tu marca al azar: priorizamos lo que aumenta consultas y ventas."
	>
		<ul class="grid gap-6 md:grid-cols-2">
			<li class="rounded-2xl border border-border bg-surface-elevated p-6 shadow-soft">
				<h3 class="font-semibold text-ink">Velocidad real</h3>
				<p class="mt-2 text-ink-muted">
					Entregas típicas en 48 a 72 horas para que puedas publicar cuando el momento importa.
				</p>
			</li>
			<li class="rounded-2xl border border-border bg-surface-elevated p-6 shadow-soft">
				<h3 class="font-semibold text-ink">Planes mensuales accesibles</h3>
				<p class="mt-2 text-ink-muted">
					Básico, Estándar y Premium con sesiones, banco de contenido y piezas listas para subir.
				</p>
			</li>
			<li class="rounded-2xl border border-border bg-surface-elevated p-6 shadow-soft">
				<h3 class="font-semibold text-ink">Lenguaje simple</h3>
				<p class="mt-2 text-ink-muted">Briefing sin vueltas: acordamos objetivo, canal y formato en palabras claras.</p>
			</li>
			<li class="rounded-2xl border border-border bg-surface-elevated p-6 shadow-soft">
				<h3 class="font-semibold text-ink">Resultados, no solo likes</h3>
				<p class="mt-2 text-ink-muted">
					Pensamos en mensaje, prueba social y llamados a la acción alineados a tu venta.
				</p>
			</li>
		</ul>
	</Section>

	<section class="py-14 md:py-20">
		<div class="mx-auto max-w-6xl px-4 md:px-6">
			<div class="rounded-3xl border border-border bg-ink px-6 py-12 text-surface md:px-12">
				<h2 class="text-2xl font-bold md:text-3xl">Planes desde $120.000 CLP / mes</h2>
				<p class="mt-4 max-w-2xl text-lg text-white/85">
					Incluyen sesiones al mes, banco de contenido y material listo para redes. Compara en la página de planes.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a
						href="/planes"
						class="inline-flex rounded-lg bg-surface px-5 py-2.5 text-sm font-semibold text-ink hover:bg-white"
					>
						Ver planes y beneficios
					</a>
					<a
						href="/contacto"
						class="inline-flex rounded-lg border border-white/30 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10"
					>
						Agendar llamada
					</a>
				</div>
			</div>
		</div>
	</section>

	<Testimonials />

	<section class="pb-16 pt-4 md:pb-24">
		<div class="mx-auto max-w-6xl px-4 text-center md:px-6">
			<h2 class="text-2xl font-bold text-ink md:text-3xl">¿Listo para ordenar tu contenido y vender más?</h2>
			<p class="mx-auto mt-4 max-w-xl text-ink-muted">
				Escríbenos o solicita cotización: respondemos con una propuesta clara y los siguientes pasos.
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<Button href="/contacto">Solicitar cotización</Button>
				<Button href="/faq" variant="secondary">Ver preguntas frecuentes</Button>
			</div>
		</div>
	</section>
</Layout>
