---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PortfolioGallery from '../components/PortfolioGallery';
import { portfolioItems } from '../content/portfolio';
---

<Layout
	title="Nuestros trabajos"
	description="Portafolio VisualBoost: producto, lifestyle, reels y edición para redes. Galería por categorías."
>
	<div class="border-b border-border bg-surface-elevated py-12 md:py-16">
		<div class="mx-auto max-w-6xl px-4 md:px-6">
			<h1 class="text-4xl font-bold tracking-tight text-ink">Nuestros trabajos</h1>
			<p class="mt-4 max-w-2xl text-lg text-ink-muted">
				Seleccioná una categoría para filtrar. Las imágenes de ejemplo pueden sustituirse por tus proyectos reales manteniendo la misma estructura en datos.
			</p>
		</div>
	</div>

	<Section title="Galería por categoría" subtitle="Producto, lifestyle, reels y edición — todo orientado a ventas digitales.">
		<PortfolioGallery client:load items={portfolioItems} />
	</Section>
</Layout>
